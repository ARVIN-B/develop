[Unit]
Description=Hamerz Plasma Shopfloor Management System Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/hamerz_shopfloor
ExecStart=/usr/bin/python3 /opt/hamerz_shopfloor/app.py
Restart=always
RestartSec=5
Environment=PORT=8090
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
